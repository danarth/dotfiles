font-family = "FiraCode Nerd Font"
font-family-bold-italic = "Cascadia Code NF"
font-family-italic = "Cascadia Code NF"

theme = duskfox

# Linux-only settings
gtk-tabs-location = bottom

# MacOS-only settings
macos-option-as-alt = left
background-opacity = 0.75
background-blur = macos-glass-regular

keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right

config-file = ?local

# Disabled the following line and using tmux again
# config-file = tmux-bindings
